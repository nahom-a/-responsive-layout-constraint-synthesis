{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "layout-constraint-synthesis systems.json",
  "type": "object",
  "required": ["systems"],
  "additionalProperties": false,
  "properties": {
    "systems": {
      "type": "object",
      "description": "One entry per layout slug (layout-01 .. layout-24), all 24 required.",
      "additionalProperties": {
        "type": "object",
        "required": ["constraints"],
        "additionalProperties": false,
        "properties": {
          "guides": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" }
          },
          "constraints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["lhs", "rhs", "op", "priority"],
              "additionalProperties": false,
              "properties": {
                "lhs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": [
                      { "type": "string" },
                      { "type": "integer", "not": { "const": 0 } }
                    ]
                  }
                },
                "rhs": { "type": "integer" },
                "op": { "enum": ["==", "<=", ">="] },
                "priority": {
                  "oneOf": [
                    { "const": "required" },
                    { "type": "integer", "minimum": 1, "maximum": 999 }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
